# Supabase project settings will be added after you create an account.
# Never commit real secret keys or social-platform access tokens.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Keep this value private and set it in the hosting dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Add the real Make webhook URL only in server-side settings after the workflow is ready.
MAKE_NOTIFICATION_WEBHOOK_URL=
