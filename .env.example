# Supabase project settings. Use the publishable key only in this browser-facing app.
# Never commit real keys, database passwords, or social-platform access tokens.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only settings. Never prefix these with NEXT_PUBLIC_ or put real values in GitHub.
SUPABASE_SERVICE_ROLE_KEY=
MAKE_NOTIFICATION_SECRET=
NOTIFICATION_OWNER_ID=

# Social publishing. Keep disabled until the Make publish scenario is configured and tested.
MAKE_SOCIAL_PUBLISH_ENABLED=false
MAKE_SOCIAL_SCHEDULER_ENABLED=false
MAKE_SOCIAL_PUBLISH_WEBHOOK_URL=
MAKE_SOCIAL_PUBLISH_API_KEY=
MAKE_SOCIAL_CALLBACK_SECRET=

# Optional assistant text-generation settings. Keep these server-only in Vercel.
OPENAI_API_KEY=
OPENAI_MODEL=
